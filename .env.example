# Shared runtime
OPENAI_MODEL=gpt-4o

# Local direct OpenAI mode only.
# Leave OPENAI_URL unset when using this variable.
OPENAI_API_KEY_DEFAULT=

# WSO2 Agent Manager governed mode.
# These values are normally injected by the attached LLM Service Provider.
OPENAI_URL=
OPENAI_API_KEY=

# Shared Logistics Core
LOGISTICS_CORE_URL=http://localhost:8010
# For workloads running inside local AMP/k3d:
# LOGISTICS_CORE_URL=http://host.k3d.internal:19080/transnova-logistics-core
# LOGISTICS_CORE_HOST_HEADER=default-default.am-gateway.localhost
LOGISTICS_CORE_HOST_HEADER=
LOGISTICS_CORE_API_KEY=
LOGISTICS_CORE_TIMEOUT_SECONDS=8

# Custom API Agent runtime port. Agent Manager injects this from the Custom API
# port configuration. Chat Agents ignore PORT and always listen on 8000.
PORT=8080
