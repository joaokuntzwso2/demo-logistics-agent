# Copy this file to .env.portal. Never commit .env.portal.
#
# Local AMP validation showed that all four deployed Agent Manager gateway
# endpoints require endpoint-specific API keys. Create a separate key for each
# workload under Security -> Credentials. Do not reuse one workload's key for
# another workload. These keys are server-side only; browser JavaScript never
# receives them.
#
# URLs below are BASE workload URLs:
# - Chat Agent URLs must NOT end in /chat (the portal appends /chat).
# - Control Tower URL must NOT end in /disruptions/analyze.
# - Core URL must NOT end in /demo/catalog.

PORTAL_PORT=8090
PORTAL_REQUEST_TIMEOUT_SECONDS=45

# Shared deterministic mock Logistics Core (Custom API Agent)
PORTAL_CORE_URL=http://default-default.am-gateway.localhost:19080/transnova-logistics-core
PORTAL_CORE_API_KEY=

# Customer Experience (Chat Agent)
PORTAL_CUSTOMER_AGENT_URL=
PORTAL_CUSTOMER_AGENT_API_KEY=

# Shipment Exception Manager (Chat Agent)
PORTAL_EXCEPTION_AGENT_URL=
PORTAL_EXCEPTION_AGENT_API_KEY=

# Network Control Tower (Custom API Agent)
PORTAL_CONTROL_TOWER_URL=
PORTAL_CONTROL_TOWER_API_KEY=
