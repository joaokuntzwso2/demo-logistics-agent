# Copy to .env.portal and fill in the four deployed Agent Manager endpoints.
# API keys remain server-side in the portal and are never sent to browser JavaScript.

PORTAL_PORT=8090
PORTAL_REQUEST_TIMEOUT_SECONDS=45

# Shared deterministic mock Logistics Core
PORTAL_CORE_URL=http://default-default.am-gateway.localhost:19080/transnova-logistics-core
PORTAL_CORE_API_KEY=

# Deployed Chat Agent endpoint, including the Agent Manager gateway path.
PORTAL_CUSTOMER_AGENT_URL=
PORTAL_CUSTOMER_AGENT_API_KEY=

# Deployed Chat Agent endpoint, including the Agent Manager gateway path.
PORTAL_EXCEPTION_AGENT_URL=
PORTAL_EXCEPTION_AGENT_API_KEY=

# Deployed Custom API Agent endpoint, including the Agent Manager gateway path.
PORTAL_CONTROL_TOWER_URL=
PORTAL_CONTROL_TOWER_API_KEY=
